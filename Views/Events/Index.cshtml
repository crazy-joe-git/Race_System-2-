@model IEnumerable<Race_System_2_.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<div class="container mt-4">
    <h2>Upcoming Race Events</h2>
    <p class="text-muted">Browse upcoming runs, walks, and cycling events and note the Event ID for registration.</p>

    @if (User.IsInRole("Organiser"))
    {
        <p>
            <a asp-action="Create" class="btn btn-primary">+ Create New Event</a>
        </p>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="card-title mb-0">@item.EventName</h5>
                            <span class="badge bg-secondary">Event ID: @item.EventID</span>
                        </div>
                        <h6 class="card-subtitle mb-2 text-muted">@item.EventType | @item.Distance km</h6>
                        <p class="card-text">@item.Description</p>
                        <ul class="list-unstyled small">
                            <li><strong>Date:</strong> @item.EventDate.ToString("yyyy-MM-dd HH:mm")</li>
                            <li><strong>Location:</strong> @item.EventLocation</li>
                            <li><strong>Organizer:</strong> @item.OrganizerName</li>
                        </ul>
                    </div>
                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center">
                        <a asp-action="Details" asp-route-id="@item.EventID" class="btn btn-outline-info btn-sm">View Details</a>

                        @if (User.IsInRole("Organiser"))
                        {
                            <div>
                                <a asp-action="Edit" asp-route-id="@item.EventID" class="btn btn-outline-secondary btn-sm">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.EventID" class="btn btn-outline-danger btn-sm">Delete</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>