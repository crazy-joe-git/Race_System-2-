@model IEnumerable<Race_System_2_.Models.Registration>

@{
    ViewData["Title"] = "Registrations";
}

<div class="container mt-4">
    <h2>Event Registrations</h2>
    <p class="text-muted">Manage and review participant event entries.</p>

    @if (User.IsInRole("Participant"))
    {
        <p>
            <a asp-action="Create" class="btn btn-primary">+ Register for an Event</a>
        </p>
    }

    <table class="table table-bordered table-striped mt-3">
        <thead class="table-dark">
            <tr>
                <th>Registration ID</th>
                <th>Participant ID</th>
                <th>Event Race ID</th>
                <th>Bid Number</th>
                <th>Payment Status</th>
                <th>Registration Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.RegistrationID</td>
                    <td>@item.ParticipantID</td>
                    <td>@item.EventRaceID</td>
                    <td>@item.BidNumber</td>
                    <td><span class="badge bg-info text-dark">@item.PaymentStatus</span></td>
                    <td>@item.Reg_Date.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>