@model IEnumerable<Race_System_2_.Models.Registration>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Reg_Date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BidNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PaymentStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ParticipantID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EventRaceID)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Reg_Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BidNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PaymentStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ParticipantID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EventRaceID)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.RegistrationID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.RegistrationID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.RegistrationID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
