@model Race_System_2_.Models.Registration

@{
    ViewData["Title"] = "Register for Event";
}

<div class="container mt-4">
    <h2>Register for Event</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="ParticipantID" class="control-label font-weight-bold">Participant ID</label>
                    <input asp-for="ParticipantID" class="form-control" />
                    <span asp-validation-for="ParticipantID" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="EventRaceID" class="control-label font-weight-bold">Event Race ID</label>
                    <input asp-for="EventRaceID" class="form-control" />
                    <span asp-validation-for="EventRaceID" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="BidNumber" class="control-label font-weight-bold">Bid Number</label>
                    <input asp-for="BidNumber" class="form-control" type="number" />
                    <span asp-validation-for="BidNumber" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="CategoryID" class="control-label font-weight-bold">Category ID</label>
                    <input asp-for="CategoryID" class="form-control" type="number" />
                    <span asp-validation-for="CategoryID" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PaymentStatus" class="control-label font-weight-bold">Payment Status</label>
                    <select asp-for="PaymentStatus" class="form-control">
                        <option value="">-- Select Status --</option>
                        <option value="Paid">Paid</option>
                        <option value="Pending">Pending</option>
                    </select>
                    <span asp-validation-for="PaymentStatus" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Register" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}