@model IEnumerable<Race_System_2_.Models.Result>

@{
    ViewData["Title"] = "Results";
}

<div class="container mt-4">
    <h2>Race Results</h2>
    <p class="text-muted">Check final placement positions and recorded finish times.</p>

    @if (User.IsInRole("Organiser"))
    {
        <p>
            <a asp-action="Create" class="btn btn-primary">+ Capture New Result</a>
        </p>
    }

    <table class="table table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Result ID</th>
                <th>Registration ID</th>
                <th>Finishing Position</th>
                <th>Finish Time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ResultID</td>
                    <td><strong>@item.RegistrationID</strong></td>
                    <td><span class="badge bg-success">Position: @item.Position</span></td>
                    <td>@item.FinishTime</td>
                </tr>
            }
        </tbody>
    </table>
</div>