@model IEnumerable<Race_System_2_.Models.Result>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FinishTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RankOverall)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RankInCategory)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RegistrationID)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.FinishTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RankOverall)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RankInCategory)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RegistrationID)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ResultID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ResultID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ResultID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
