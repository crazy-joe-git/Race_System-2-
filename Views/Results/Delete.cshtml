@model Race_System_2_.Models.Result

@{
    ViewData["Title"] = "Delete Result";
}

<div class="container mt-4">
    <h2 class="text-danger">Delete Result</h2>
    <h3>Are you sure you want to delete this result?</h3>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Result ID</dt>
        <dd class="col-sm-9">@Model.ResultID</dd>

        <dt class="col-sm-3">Registration ID</dt>
        <dd class="col-sm-9">@Model.RegistrationID</dd>

        <dt class="col-sm-3">Finishing Position</dt>
        <dd class="col-sm-9">@Model.Position</dd>

        <dt class="col-sm-3">Finish Time</dt>
        <dd class="col-sm-9">@Model.FinishTime</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ResultID" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary ms-2">Back to List</a>
    </form>
</div>