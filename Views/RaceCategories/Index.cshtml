@model IEnumerable<Race_System_2_.Models.RaceCategory>

@{
    ViewData["Title"] = "Categories";
}

<div class="container mt-4">
    <h2>Race Categories</h2>
    <p class="text-muted">Explore age and distance categories available for events.</p>

    @if (User.IsInRole("Organiser"))
    {
        <p>
            <a asp-action="Create" class="btn btn-primary">+ Add New Category</a>
        </p>
    }

    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>Category Name</th>
                <th>Description</th>
                @if (User.IsInRole("Organiser"))
                {
                    <th class="text-end">Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.CategoryName</strong></td>
                    <td>@item.Category_description</td>
                    @if (User.IsInRole("Organiser"))
                    {
                        <td class="text-end">
                            <a asp-action="Delete" asp-route-id="@item.CategoryID" class="btn btn-outline-danger btn-sm">Delete</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>